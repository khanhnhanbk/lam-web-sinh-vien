---
// Khung chung: <head> (SEO, ảnh xem trước Zalo/Facebook), font, chế độ sáng/tối, hiện dần khi cuộn.
import '../styles/global.css';
const { title, description = '', image = '/og.jpg' } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const img = new URL(image, Astro.site);
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#1f6f5c" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={img} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="vi_VN" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;700;800&display=swap" rel="stylesheet" />
  <!-- Chạy trước khi vẽ để không chớp màu: lấy lựa chọn cũ, không có thì theo hệ thống -->
  <script is:inline>
    try {
      document.documentElement.dataset.theme = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch (e) { document.documentElement.dataset.theme = 'light'; }
  </script>
  <noscript><style>.len{opacity:1!important;transform:none!important}</style></noscript>
</head>
<body class="font-sans antialiased">
  <slot />
  <script is:inline>
    // Nút sáng/tối
    document.querySelectorAll('[data-doi-theme]').forEach((b) => b.addEventListener('click', () => {
      const r = document.documentElement;
      r.dataset.theme = r.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem('theme', r.dataset.theme); } catch (e) {}
    }));
    // Hiện dần khi cuộn tới
    const io = 'IntersectionObserver' in window && new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('hien'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.len').forEach((el) => (io ? io.observe(el) : el.classList.add('hien')));
  </script>
</body>
</html>
