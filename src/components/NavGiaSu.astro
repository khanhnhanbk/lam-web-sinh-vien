---
// Menu kính mờ cho 2 trang dành cho thầy cô dạy kèm: Hỏi đáp và Chuẩn bị.
import Icon from './Icon.astro';
import d from '../data/noi-dung.json';
const { hienTai } = Astro.props; // 'hoi-dap' | 'chuan-bi'
const link = (id: string) => `rounded-full px-3 py-1.5 text-sm font-bold ${hienTai === id ? 'bg-white/20' : 'hover:bg-white/15'}`;
---
<nav class="khong-in nav-kinh fixed inset-x-3 top-3 z-30 mx-auto flex max-w-5xl items-center justify-between gap-2 rounded-full py-2 pr-2 pl-4 text-white">
  <a href="/gia-su/hoi-dap.html" class="shrink-0 font-extrabold">{d.thuong_hieu}</a>
  <div class="flex items-center gap-1">
    <a href="/gia-su/hoi-dap.html" class={link('hoi-dap')} aria-current={hienTai === 'hoi-dap' ? 'page' : undefined}>Hỏi đáp</a>
    <a href="/gia-su/chuan-bi.html" class={link('chuan-bi')} aria-current={hienTai === 'chuan-bi' ? 'page' : undefined}>Chuẩn bị</a>
    <button data-doi-theme type="button" aria-label="Đổi giao diện sáng/tối" class="grid size-9 shrink-0 place-items-center rounded-full hover:bg-white/15">
      <span class="dark:hidden"><Icon name="moon" /></span><span class="hidden dark:inline"><Icon name="sun" /></span>
    </button>
    <a href={`https://zalo.me/${d.zalo}`} class="btn hidden bg-white px-4 py-2 text-sm text-(--g1) sm:inline-flex">Nhắn Zalo</a>
  </div>
</nav>
