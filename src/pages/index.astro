---
// Trang bán gói web cho sinh viên. Chữ lấy từ src/data/noi-dung.json, màu/kiểu lấy từ global.css.
// Điện thoại trước: 1 cột. Màn rộng (lg ≥ 1024px): đầu trang 2 cột, bento 3 cột, khung tối đa 1152px.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import d from '../data/noi-dung.json';
const zalo = `https://zalo.me/${d.zalo}`;
const tel = `tel:+${d.zalo}`;
// Bento "Vì sao": ô đầu cao 2 hàng, ô cuối rộng 2 cột
const viSaoO = ['lg:row-span-2 bg-brand text-brand-ink border-transparent', '', '', 'lg:col-span-2'];
const ngoai = (link: string) => link.startsWith('http');
---
<Base title={d.seo.title} description={d.seo.description}>
  <!-- 1. ĐẦU TRANG: gradient tràn ngang, menu kính mờ dính trên cùng -->
  <header class="hero relative overflow-hidden rounded-b-[28px] bg-gradient-to-br from-(--g1) via-(--g2) to-(--g3) text-white lg:rounded-b-[44px]">
    <nav class="khong-in nav-kinh fixed inset-x-3 top-3 z-30 mx-auto flex max-w-6xl items-center justify-between rounded-full px-4 py-2 text-white">
      <a href="#" class="font-bold"><b class="font-extrabold">{d.thuong_hieu}</b> <span class="opacity-80">· {d.thuong_hieu_phu}</span></a>
      <div class="flex items-center gap-1.5">
        <a href="#bang-gia" class="hidden rounded-full px-3 py-1.5 text-sm font-bold hover:bg-white/15 md:inline">Bảng giá</a>
        <a href="#mau" class="hidden rounded-full px-3 py-1.5 text-sm font-bold hover:bg-white/15 md:inline">Trang mẫu</a>
        <button data-doi-theme type="button" aria-label="Đổi giao diện sáng/tối" class="grid size-9 place-items-center rounded-full hover:bg-white/15">
          <span class="dark:hidden"><Icon name="moon" /></span><span class="hidden dark:inline"><Icon name="sun" /></span>
        </button>
        <a href={zalo} target="_blank" rel="noopener" class="btn bg-white px-4 py-2 text-sm text-(--g1)">Nhắn Zalo</a>
      </div>
    </nav>

    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 pt-24 pb-12 lg:grid-cols-[1.2fr_1fr] lg:px-8 lg:pt-32 lg:pb-20">
      <div class="len">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-sm font-bold"><span class="size-2 rounded-full bg-accent"></span>{d.hero.nhan}</span>
        <h1 class="mt-4 text-[2.1rem] leading-[1.12] font-extrabold tracking-tight sm:text-5xl lg:text-[3.4rem]">
          <span class="block [text-wrap:balance]">{d.hero.tieu_de[0]}</span>
          <span class="block text-accent [text-wrap:balance]">{d.hero.tieu_de[1]}</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg opacity-90">{d.hero.mo_ta}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#bang-gia" class="btn bg-white text-(--g1) lg:px-7 lg:py-3.5 lg:text-lg">{d.hero.nut_chinh}<Icon name="arrowRight" class="size-4" /></a>
          <a href="#mau" class="btn border-[1.5px] border-white/70 lg:px-7 lg:py-3.5 lg:text-lg">{d.hero.nut_phu}</a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-bold">
          {d.hero.diem.map((x) => <li class="flex items-center gap-1.5"><Icon name="check" class="size-4 text-accent" stroke={2.6} />{x}</li>)}
        </ul>
      </div>

      <!-- Điện thoại mô phỏng một trang mẫu (chỉ để minh hoạ, không đọc bằng máy đọc màn hình) -->
      <div class="len mx-auto w-full max-w-[290px] lg:max-w-[320px]" aria-hidden="true">
        <div class="glass rounded-[2.4rem] p-3 shadow-2xl">
          <div class="rounded-[1.9rem] bg-bg p-4 text-ink">
            <div class="mx-auto mb-4 h-1.5 w-16 rounded-full bg-line"></div>
            <div class="rounded-2xl bg-gradient-to-br from-(--g1) to-(--g2) p-4 text-center text-white">
              <div class="mx-auto grid size-14 place-items-center rounded-full border-[3px] border-white bg-white/25 text-lg font-extrabold">MT</div>
              <p class="mt-2 text-sm font-bold">Minh Thư</p>
              <p class="text-[11px] opacity-90">Gia sư Toán · Sư phạm TP.HCM</p>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-2">
              <div class="rounded-xl bg-brand p-2.5 text-brand-ink"><b class="block text-base">3 năm</b><span class="text-[11px]">dạy kèm</span></div>
              <div class="rounded-xl border border-line bg-card p-2.5"><b class="block text-base">40+</b><span class="text-[11px] text-muted">học sinh</span></div>
              <div class="col-span-2 rounded-xl border border-line bg-card p-2.5 text-[11px]"><b class="text-xs">Lớp 6–9</b> · 150.000đ / buổi</div>
            </div>
            <div class="mt-3 rounded-full bg-brand py-2 text-center text-xs font-bold text-brand-ink">Nhắn Zalo</div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 pb-28 lg:px-8 lg:pb-16">
    <!-- 2. VÌ SAO: bento -->
    <section class="mt-16 lg:mt-24">
      <h2 class="len text-2xl font-extrabold tracking-tight lg:text-4xl">{d.vi_sao.tieu_de}</h2>
      <p class="len mt-2 max-w-2xl text-muted lg:text-lg">{d.vi_sao.mo_ta}</p>
      <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 lg:gap-4">
        {d.vi_sao.o.map((o, i) => (
          <div class={`tile len flex flex-col p-6 lg:p-7 ${viSaoO[i]}`}>
            <span class={`grid size-11 place-items-center rounded-xl ${i === 0 ? 'bg-white/20' : 'bg-soft text-brand'}`}><Icon name={o.icon} /></span>
            <h3 class={`mt-4 font-bold ${i === 0 ? 'text-2xl lg:mt-auto lg:text-3xl' : 'text-lg'}`}>{o.tieu_de}</h3>
            <p class={`mt-1.5 ${i === 0 ? 'opacity-90 lg:text-lg' : 'text-muted'}`}>{o.noi_dung}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. BẢNG GIÁ: 3 thẻ cao bằng nhau, giá thẳng hàng, dòng "sửa / giao" nằm cùng hàng ở đáy -->
    <section id="bang-gia" class="mt-16 lg:mt-24">
      <h2 class="len text-2xl font-extrabold tracking-tight lg:text-4xl">{d.bang_gia.tieu_de}</h2>
      <p class="len mt-2 max-w-2xl text-muted lg:text-lg">{d.bang_gia.mo_ta}</p>
      <div class="mt-7 grid gap-4 md:grid-cols-3">
        {d.bang_gia.goi.map((g) => (
          <div class={`tile len relative flex flex-col p-6 lg:p-7 ${g.noi_bat ? 'border-2 border-brand shadow-xl shadow-brand/10' : ''}`}>
            <div class="flex items-center justify-between gap-2">
              <span class="chip self-start">{g.ten}</span>
              {g.noi_bat && <span class="rounded-full bg-accent px-2.5 py-0.5 text-xs font-bold text-[#1d1b18]">{d.bang_gia.nhan_noi_bat}</span>}
            </div>
            <p class="mt-4 text-3xl font-extrabold tracking-tight lg:text-4xl">{g.gia}</p>
            <ul class="mt-5 mb-6 space-y-2.5">
              {g.y.map((y) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-brand" stroke={2.4} />{y}</li>)}
            </ul>
            <div class="mt-auto flex justify-between gap-2 border-t border-line pt-4 text-sm font-bold text-muted">
              <span>{g.sua}</span><span>{g.giao}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="len mt-5 max-w-3xl text-sm text-muted">{d.bang_gia.ghi_chu}</p>
    </section>

    <!-- 4. QUY TRÌNH: 5 bước -->
    <section class="mt-16 lg:mt-24">
      <h2 class="len text-2xl font-extrabold tracking-tight lg:text-4xl">{d.quy_trinh.tieu_de}</h2>
      <p class="len mt-2 max-w-2xl text-muted lg:text-lg">{d.quy_trinh.mo_ta}</p>
      <ol class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {d.quy_trinh.buoc.map((b, i) => (
          <li class="tile len flex gap-3 p-5 lg:flex-col">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand text-sm font-extrabold text-brand-ink">{i + 1}</span>
            <span class="font-medium">{b}</span>
          </li>
        ))}
      </ol>
      <p class="len mt-5 max-w-3xl text-sm text-muted">{d.quy_trinh.ghi_chu}</p>
    </section>

    <!-- 5. SẢN PHẨM MẪU: thẻ đầu (trang giáo viên mới nhất) rộng 2 cột -->
    <section id="mau" class="mt-16 lg:mt-24">
      <h2 class="len text-2xl font-extrabold tracking-tight lg:text-4xl">{d.mau.tieu_de}</h2>
      <p class="len mt-2 max-w-2xl text-muted lg:text-lg">{d.mau.mo_ta}</p>
      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {d.mau.the.map((t, i) => (
          <a href={t.link} {...(ngoai(t.link) ? { target: '_blank', rel: 'noopener' } : {})}
            class={`tile len group flex flex-col p-6 transition hover:-translate-y-0.5 hover:shadow-lg ${i === 0 ? 'bg-gradient-to-br from-(--g1) to-(--g2) text-white border-transparent sm:col-span-2' : ''}`}>
            <span class={`chip self-start ${i === 0 ? 'bg-white/20 text-white' : ''}`}>{t.nhan}</span>
            <h3 class={`mt-3 font-bold ${i === 0 ? 'text-2xl lg:text-3xl' : 'text-lg'}`}>{t.tieu_de}</h3>
            <p class={`mt-1 ${i === 0 ? 'opacity-90 lg:text-lg' : 'text-muted'}`}>{t.noi_dung}</p>
            <span class={`mt-auto inline-flex items-center gap-1.5 pt-4 font-bold ${i === 0 ? '' : 'text-brand'}`}>{d.mau.xem}<Icon name={ngoai(t.link) ? 'external' : 'arrowRight'} class="size-4" /></span>
            <span class="chi-in hidden">{ngoai(t.link) ? t.link : `${Astro.site}${t.link.slice(1)}`}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. AI LÀM -->
    <section class="mt-16 lg:mt-24">
      <div class="tile len flex flex-col items-center gap-5 p-6 text-center sm:flex-row sm:text-left lg:p-8">
        <div class="grid size-20 shrink-0 place-items-center rounded-full bg-gradient-to-br from-(--g1) to-(--g3) text-3xl font-extrabold text-white">N</div>
        <div>
          <h2 class="text-xl font-extrabold lg:text-2xl">{d.ve_minh.tieu_de}</h2>
          <!-- Mỗi câu một dòng; cụm tên riêng giữ nguyên trên một dòng (nbsp) -->
          <p class="mt-1.5 text-pretty text-muted lg:text-lg">
            <span class="block">Mình là <b class="text-ink">{d.ve_minh.ten}</b>.</span>
            {d.ve_minh.noi_dung.split('. ').map((c, i, a) => <span class="block">{(i < a.length - 1 ? `${c}.` : c).replace(/(ĐH|Bách Khoa|Khoa học|landing|Python|Sài) /g, '$1\u00a0')}</span>)}
          </p>
        </div>
      </div>
    </section>

    <!-- 7. LIÊN HỆ CUỐI TRANG -->
    <section id="lien-he" class="mt-16 lg:mt-24">
      <div class="len rounded-[28px] bg-gradient-to-br from-(--g1) via-(--g2) to-(--g3) px-6 py-12 text-center text-white lg:py-16">
        <h2 class="text-3xl font-extrabold tracking-tight lg:text-5xl">{d.cuoi.tieu_de}</h2>
        <p class="mx-auto mt-3 max-w-xl text-lg opacity-90">{d.cuoi.mo_ta}</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href={zalo} target="_blank" rel="noopener" class="btn bg-white text-(--g1) lg:px-7 lg:py-3.5 lg:text-lg"><Icon name="chat" />{d.cuoi.nut_zalo}</a>
          <a href={tel} class="btn border-[1.5px] border-white/70 lg:px-7 lg:py-3.5 lg:text-lg"><Icon name="phone" />{d.cuoi.nut_goi} {d.dien_thoai_hien_thi}</a>
        </div>
        <p class="mt-6 text-sm opacity-90">Zalo / điện thoại: {d.dien_thoai_hien_thi} · Email: <a class="underline" href={`mailto:${d.email}`}>{d.email}</a></p>
      </div>
    </section>
  </main>

  <footer class="pb-24 text-center text-sm text-muted lg:pb-10">© 2026 {d.thuong_hieu} · Nguyễn Văn Khánh Nhân</footer>

  <!-- Nút Zalo nổi ở đáy màn hình điện thoại -->
  <div class="khong-in fixed inset-x-0 bottom-0 z-30 flex gap-2.5 border-t border-line bg-bg/90 px-4 py-3 backdrop-blur sm:hidden">
    <a href={zalo} target="_blank" rel="noopener" class="btn flex-1 bg-brand text-brand-ink"><Icon name="chat" />Nhắn Zalo</a>
    <a href={tel} class="btn flex-1 border-[1.5px] border-brand text-brand"><Icon name="phone" />Gọi</a>
  </div>
</Base>
