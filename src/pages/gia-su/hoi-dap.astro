---
// Hỏi đáp + kiến thức cơ bản về trang web, viết cho thầy cô dạy kèm (khách chưa biết web là gì).
// Chữ ở src/data/gia-su/hoi-dap.json. Cuối trang dẫn sang trang Chuẩn bị.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import NavGiaSu from '../../components/NavGiaSu.astro';
import d from '../../data/gia-su/hoi-dap.json';
import chung from '../../data/noi-dung.json';
const zalo = `https://zalo.me/${chung.zalo}`;
---
<Base title={d.seo.title} description={d.seo.description}>
  <header class="hero relative overflow-hidden rounded-b-[28px] bg-gradient-to-br from-(--g1) via-(--g2) to-(--g3) text-white lg:rounded-b-[44px]">
    <NavGiaSu hienTai="hoi-dap" />
    <div class="mx-auto max-w-5xl px-5 pt-24 pb-12 lg:px-8 lg:pt-32 lg:pb-16">
      <div class="len">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-sm font-bold"><span class="size-2 rounded-full bg-accent"></span>{d.hero.nhan}</span>
        <h1 class="mt-4 text-[2rem] leading-[1.15] font-extrabold tracking-tight sm:text-5xl">
          <span class="block">{d.hero.tieu_de[0]}</span>
          <span class="block text-accent">{d.hero.tieu_de[1]}</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg opacity-90">{d.hero.mo_ta}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/gia-su/chuan-bi.html" class="btn bg-white text-(--g1)">{d.hero.nut_chinh}<Icon name="arrowRight" class="size-4" /></a>
          <a href="#hoi-dap" class="btn border-[1.5px] border-white/70">{d.hero.nut_phu}</a>
        </div>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-4 pb-28 lg:px-8 lg:pb-16">
    <!-- 1. KIẾN THỨC: 4 thẻ đều nhau + 1 thẻ dẫn sang trang mẫu -->
    <section id="kien-thuc" class="mt-14 lg:mt-20">
      <h2 class="len text-2xl font-extrabold tracking-tight lg:text-4xl">{d.kien_thuc.tieu_de}</h2>
      <p class="len mt-2 max-w-2xl text-muted lg:text-lg">{d.kien_thuc.mo_ta}</p>
      <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:gap-4">
        {d.kien_thuc.o.map((o) => (
          <div class="tile len flex flex-col p-6">
            <div class="flex items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-soft text-brand"><Icon name={o.icon} /></span>
              <h3 class="text-lg font-bold">{o.tieu_de}</h3>
            </div>
            <p class="mt-3 text-pretty text-muted">{o.noi_dung}</p>
          </div>
        ))}
        <a href={d.kien_thuc.mau_link} target="_blank" rel="noopener"
          class="tile len group flex items-center justify-between gap-4 border-transparent bg-gradient-to-br from-(--g1) to-(--g2) p-6 text-white transition hover:-translate-y-0.5 hover:shadow-lg sm:col-span-2">
          <span>
            <b class="block text-lg">{d.kien_thuc.mau_tieu_de}</b>
            <span class="opacity-90">{d.kien_thuc.mau_mo_ta}</span>
          </span>
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white/20"><Icon name="external" /></span>
        </a>
      </div>
    </section>

    <!-- 2. HỎI ĐÁP: details/summary, mở được không cần JS -->
    <section id="hoi-dap" class="mt-14 lg:mt-20">
      <h2 class="len text-2xl font-extrabold tracking-tight lg:text-4xl">{d.hoi_dap.tieu_de}</h2>
      <p class="len mt-2 text-muted lg:text-lg">{d.hoi_dap.mo_ta}</p>
      <div class="mt-7 space-y-2.5">
        {d.hoi_dap.cau.map((c, i) => (
          <details class="tile len group overflow-hidden" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-bold lg:text-lg [&::-webkit-details-marker]:hidden">
              <span>{c.hoi}</span>
              <Icon name="chevronDown" class="size-5 shrink-0 text-brand transition group-open:rotate-180" />
            </summary>
            <p class="-mt-1 px-5 pb-5 text-pretty text-muted lg:text-lg">{c.dap}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- 3. AI LÀM: link portfolio -->
    <section class="mt-14 lg:mt-20">
      <div class="tile len flex flex-col items-center gap-5 p-6 text-center sm:flex-row sm:text-left lg:p-8">
        <div class="grid size-20 shrink-0 place-items-center rounded-full bg-gradient-to-br from-(--g1) to-(--g3) text-3xl font-extrabold text-white">N</div>
        <div class="flex-1">
          <h2 class="text-xl font-extrabold lg:text-2xl">{d.ve_minh.tieu_de}</h2>
          <!-- Mỗi câu một dòng; cụm tên riêng giữ nguyên trên một dòng (nbsp) -->
          <p class="mt-1.5 text-pretty text-muted lg:text-lg">
            <span class="block">Mình là <b class="text-ink">{d.ve_minh.ten}</b>.</span>
            {d.ve_minh.noi_dung.split('. ').map((c, i, a) => <span class="block">{(i < a.length - 1 ? `${c}.` : c).replace(/(ĐH|Bách Khoa|Khoa học|landing|Python|Sài) /g, '$1\u00a0')}</span>)}
          </p>
          <div class="mt-4 flex flex-wrap justify-center gap-2.5 sm:justify-start">
            <a href={d.ve_minh.link} target="_blank" rel="noopener" class="btn bg-brand text-brand-ink"><Icon name="user" />{d.ve_minh.nut}</a>
            <a href={zalo} target="_blank" rel="noopener" class="btn border-[1.5px] border-brand text-brand"><Icon name="chat" />Nhắn Zalo</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. BƯỚC TIẾP THEO -->
    <section class="mt-14 lg:mt-20">
      <div class="len rounded-[28px] bg-gradient-to-br from-(--g1) via-(--g2) to-(--g3) px-6 py-12 text-center text-white lg:py-14">
        <h2 class="text-3xl font-extrabold tracking-tight lg:text-4xl">{d.tiep_theo.tieu_de}</h2>
        <p class="mx-auto mt-3 max-w-xl text-lg opacity-90">{d.tiep_theo.mo_ta}</p>
        <a href="/gia-su/chuan-bi.html" class="btn mt-7 bg-white text-(--g1) lg:px-7 lg:py-3.5 lg:text-lg">{d.tiep_theo.nut}<Icon name="arrowRight" class="size-4" /></a>
      </div>
    </section>
  </main>

  <footer class="pb-24 text-center text-sm text-muted lg:pb-10">© 2026 {chung.thuong_hieu} · Nguyễn Văn Khánh Nhân · <a class="underline" href="https://khanhnhanbk.github.io" target="_blank" rel="noopener">khanhnhanbk.github.io</a></footer>

  <div class="khong-in fixed inset-x-0 bottom-0 z-30 flex gap-2.5 border-t border-line bg-bg/90 px-4 py-3 backdrop-blur sm:hidden">
    <a href="/gia-su/chuan-bi.html" class="btn flex-1 whitespace-nowrap bg-brand text-brand-ink">Chuẩn bị</a>
    <a href={zalo} target="_blank" rel="noopener" class="btn flex-1 border-[1.5px] border-brand text-brand"><Icon name="chat" />Zalo</a>
  </div>
</Base>
