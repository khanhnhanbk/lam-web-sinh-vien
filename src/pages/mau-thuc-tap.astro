---
// Trang mẫu: xin thực tập. Chữ ở src/data/mau/thuc-tap.json. Cùng khuôn với trang giáo viên.
import Base from '../layouts/Base.astro';
import BangMau from '../components/BangMau.astro';
import Icon from '../components/Icon.astro';
import d from '../data/mau/thuc-tap.json';
---
<Base title={`${d.ten} · ${d.chuc_danh.join(' · ')} (trang mẫu)`} description={d.muc_tieu}>
  <BangMau />
  <header class="hero rounded-b-[28px] bg-gradient-to-br from-(--g1) via-(--g2) to-(--g3) text-white lg:rounded-b-[40px]">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 px-5 pt-12 pb-12 text-center sm:flex-row sm:text-left lg:pt-16 lg:pb-16">
      <div class="len grid size-24 shrink-0 place-items-center rounded-3xl border-4 border-white bg-white/20 text-4xl font-extrabold lg:size-28">{d.viet_tat}</div>
      <div class="len">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-sm font-bold"><span class="size-2 rounded-full bg-accent"></span>{d.trang_thai}</span>
        <h1 class="mt-3 text-3xl font-extrabold lg:text-5xl">{d.ten}</h1>
        <p class="mt-1 font-bold opacity-90 lg:text-lg"><span class="block sm:inline">{d.chuc_danh[0]}</span><span class="hidden sm:inline"> · </span><span class="block sm:inline">{d.chuc_danh[1]}</span></p>
        <p class="mt-3 max-w-xl opacity-90 lg:text-lg">{d.muc_tieu}</p>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-4xl px-4 pb-16">
    <div class="len -mt-6 flex flex-wrap justify-center gap-2.5 sm:justify-start">
      {d.lien_ket.map((l) => (
        <a href="#" class={`btn shadow-sm ${l.chinh ? 'bg-brand text-brand-ink' : 'border border-line bg-card'}`}><Icon name={l.icon} class="size-4" />{l.nhan}</a>
      ))}
    </div>

    <section class="mt-12">
      <h2 class="len text-2xl font-extrabold lg:text-3xl">Dự án nổi bật</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {d.du_an.map((p) => (
          <div class="tile len flex flex-col p-6">
            <h3 class="text-lg font-bold">{p.ten}</h3>
            <p class="mt-1.5 mb-4 text-muted">{p.mo_ta}</p>
            <p class="mt-auto rounded-xl bg-soft px-3 py-2 text-sm font-bold text-brand">{p.ket_qua}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="len text-2xl font-extrabold lg:text-3xl">Kỹ năng</h2>
      <div class="len mt-5 flex flex-wrap gap-2">
        {d.ky_nang.map((k) => <span class="chip px-3 py-1.5 text-sm">{k}</span>)}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="len text-2xl font-extrabold lg:text-3xl">Học vấn và hoạt động</h2>
      <ol class="tile len mt-5 space-y-5 p-6 lg:p-8">
        {d.hoc_van.map((h) => (
          <li class="relative border-l-2 border-brand pl-4">
            <b class="block">{h.ten}</b><span class="text-sm text-muted">{h.thoi_gian}</span>
          </li>
        ))}
      </ol>
    </section>

    <p class="len mt-12 text-center text-muted">{d.loi_cuoi}</p>
  </main>
</Base>
